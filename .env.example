# Copy to `.env` in this folder (`.env` is gitignored) and fill in real values.
# No quotes needed for simple values.

APP_ENV=development
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_INCLUDE_PATH=false
# Optional: credits ↔ money (defaults: 5_000 credits, USD $5.00 per pack in cents).
# DEFAULT_TOPUP_CREDITS=5000
# CENTS_PER_TOPUP_PACK=500
